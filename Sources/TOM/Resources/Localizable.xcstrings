    "Downloads about 4 GB. You can keep using your Mac while this runs in the background.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt etwa 4 GB. Der Mac kann normal weiterverwendet werden, während der Download im Hintergrund läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga unos 4 GB. Puedes seguir usando tu Mac mientras se ejecuta en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge environ 4 Go. Vous pouvez continuer à utiliser votre Mac pendant l'opération en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica circa 4 GB. Puoi continuare a usare il Mac mentre l'operazione prosegue in background."
          }
        }
      }
    },
    "Empty — using the bundled default prompt. Type here to override.": {
      "localizations": {
