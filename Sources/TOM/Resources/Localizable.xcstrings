    "Models are still downloading in the background. You can record now — transcription and summaries will run as soon as their model is ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modelle werden noch im Hintergrund geladen. Aufnahmen sind bereits möglich — Transkription und Zusammenfassungen laufen, sobald das jeweilige Modell bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos aún se están descargando en segundo plano. Puedes grabar ahora — la transcripción y los resúmenes se ejecutarán en cuanto su modelo esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles sont encore en cours de téléchargement en arrière-plan. Vous pouvez enregistrer dès maintenant — la transcription et les résumés seront lancés dès que leur modèle sera prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli sono ancora in download in background. Puoi registrare subito — trascrizione e riepiloghi verranno eseguiti non appena il rispettivo modello sarà pronto."
          }
        }
      }
    },
