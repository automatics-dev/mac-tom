    "Select a recording to begin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Starten eine Aufnahme auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una grabación para empezar"
          }
        },
        "fr": {
          "stringUnit": {
