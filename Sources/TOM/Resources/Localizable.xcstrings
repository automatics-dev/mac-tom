    "AI models aren't ready yet. Open Settings → AI Models and finish the model downloads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Modelle sind noch nicht bereit. Einstellungen → KI-Modelle öffnen und die Modell-Downloads abschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de IA aún no están listos. Abre Ajustes → Modelos de IA y completa las descargas de los modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles d'IA ne sont pas encore prêts. Ouvrez Réglages → Modèles d'IA et terminez le téléchargement des modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli IA non sono ancora pronti. Apri Impostazioni → Modelli IA e completa il download dei modelli."
          }
        }
