    "TOM needs the microphone to record your voice. Turn it on for TOM in System Settings › Privacy & Security › Microphone, or switch the microphone off in the record panel to record system audio only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM braucht das Mikrofon, um deine Stimme aufzunehmen. Aktiviere es für TOM unter Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon, oder schalte das Mikrofon im Aufnahmefenster aus, um nur das Systemaudio aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM necesita el micrófono para grabar tu voz. Actívalo para TOM en Ajustes del Sistema › Privacidad y seguridad › Micrófono, o desactiva el micrófono en el panel de grabación para grabar solo el audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM a besoin du micro pour enregistrer votre voix. Activez-le pour TOM dans Réglages Système › Confidentialité et sécurité › Micro, ou coupez le micro dans le panneau d’enregistrement pour n’enregistrer que l’audio du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM ha bisogno del microfono per registrare la tua voce. Attivalo per TOM in Impostazioni di Sistema › Privacy e sicurezza › Microfono, oppure disattiva il microfono nel pannello di registrazione per registrare solo l’audio di sistema."
          }
        }
      }
    },
    "TOM needs two permissions to record": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM benötigt zwei Berechtigungen für Aufnahmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM necesita dos permisos para grabar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM a besoin de deux autorisations pour enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM ha bisogno di due autorizzazioni per registrare"
          }
        }
      }
    },
    "TOM — Library": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TOM — Bibliothek"
          }
        },
        "es": {
