    "Could not reach %@ to verify the key: %@. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte zur Überprüfung des Schlüssels nicht erreicht werden: %@. Bitte Verbindung prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con %@ para verificar la clave: %@. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@ pour vérifier la clé : %@. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@ per verificare la chiave: %@. Controlla la connessione e riprova."
          }
        }
      }
    },
    "Custom prompts apply only to new meetings or when re-transcribing existing ones. They are not applied retroactively to your meeting history.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Prompts gelten nur für neue Meetings oder beim erneuten Transkribieren bestehender Meetings. Sie werden nicht rückwirkend auf den Meeting-Verlauf angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones personalizadas solo se aplican a las reuniones nuevas o al volver a transcribir las existentes. No se aplican retroactivamente a tu historial de reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prompts personnalisés ne s'appliquent qu'aux nouvelles réunions ou lors de la retranscription de réunions existantes. Ils ne sont pas appliqués rétroactivement à votre historique de réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prompt personalizzati si applicano solo alle nuove riunioni o quando si ritrascrivono quelle esistenti. Non vengono applicati retroattivamente alla cronologia delle riunioni."
          }
        }
      }
    },
