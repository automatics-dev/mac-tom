    "Runs a full Whisper pass once recording stops, replacing the live transcript with the most accurate version. Needs the Whisper model downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt nach dem Stoppen der Aufnahme einen vollständigen Whisper-Durchlauf aus und ersetzt das Live-Transkript durch die genaueste Version. Erfordert das geladene Whisper-Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una pasada completa de Whisper al detener la grabación, sustituyendo la transcripción en directo por la versión más precisa. Requiere tener descargado el modelo Whisper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une passe Whisper complète à la fin de l'enregistrement, en remplaçant la transcription en direct par la version la plus précise. Nécessite que le modèle Whisper soit téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue un passaggio completo di Whisper al termine della registrazione, sostituendo la trascrizione in tempo reale con la versione più accurata. Richiede il modello Whisper scaricato."
          }
        }
      }
    },
