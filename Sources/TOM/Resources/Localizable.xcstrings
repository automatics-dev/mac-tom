    "Words appear while you talk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter erscheinen, während du sprichst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aparecen mientras hablas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots apparaissent pendant que vous parlez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole appaiono mentre parli"
          }
        }
      }
    },
    "You may need to restart TOM after granting Screen Recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Erteilen der Bildschirmaufnahme-Berechtigung muss TOM eventuell neu gestartet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tengas que reiniciar TOM después de conceder el permiso de grabación de pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez peut-être redémarrer TOM après avoir autorisé l'enregistrement de l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere necessario riavviare TOM dopo aver concesso l'autorizzazione Registrazione schermo"
          }
        }
      }
    },
    "You're All Set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto pronto"
          }
        }
      }
    },
    "Your API key is stored in macOS Keychain on this Mac. Transcripts and questions are sent to %@ only while this backend is selected. Audio recordings and the search index remain local.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel wird im macOS-Schlüsselbund auf diesem Mac gesichert. Transkripte und Fragen werden nur an %@ gesendet, solange dieses Backend ausgewählt ist. Audioaufnahmen und der Suchindex bleiben lokal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de API se guarda en el llavero de macOS en este Mac. Las transcripciones y preguntas se envían a %@ solo mientras este backend está seleccionado. Las grabaciones de audio y el índice de búsqueda permanecen en tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé d'API est stockée dans le trousseau macOS sur ce Mac. Les transcriptions et les questions ne sont envoyées à %@ que lorsque ce backend est sélectionné. Les enregistrements audio et l'index de recherche restent en local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave API è archiviata nel portachiavi macOS su questo Mac. Trascrizioni e domande vengono inviate a %@ solo mentre questo backend è selezionato. Le registrazioni audio e l'indice di ricerca restano locali."
          }
        }
      }
    },
    "Your data is never stored on our servers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Daten auf unseren Servern gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos nunca se almacenan en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données ne sont jamais stockées sur nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati non vengono mai archiviati sui nostri server."
          }
        }
      }
    },
