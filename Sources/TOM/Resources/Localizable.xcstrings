    "Pick which model turns speech into text while you record. Parakeet transcribes in real time across 25 languages; Whisper is slower but the most accurate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, welches Modell während der Aufnahme Sprache in Text umwandelt. Parakeet transkribiert in Echtzeit in 25 Sprachen; Whisper ist langsamer, aber am genauesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué modelo convierte la voz en texto mientras grabas. Parakeet transcribe en tiempo real en 25 idiomas; Whisper es más lento, pero el más preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le modèle qui convertit la parole en texte pendant l'enregistrement. Parakeet transcrit en temps réel dans 25 langues ; Whisper est plus lent, mais le plus précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale modello converte la voce in testo durante la registrazione. Parakeet trascrive in tempo reale in 25 lingue; Whisper è più lento ma il più accurato."
          }
        }
      }
    },
    "Pick which model writes summaries, extracts action points, and answers questions across your recordings. Voice AI and Search AI are unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, welches Modell Zusammenfassungen schreibt, Aktionspunkte extrahiert und Fragen über alle Aufnahmen hinweg beantwortet. Voice AI und Search AI sind davon nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué modelo escribe los resúmenes, extrae los puntos de acción y responde preguntas sobre tus grabaciones. La IA de voz y la IA de búsqueda no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le modèle qui rédige les résumés, extrait les points d'action et répond aux questions sur vos enregistrements. Voice AI et Search AI ne sont pas concernées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale modello scrive i riepiloghi, estrae i punti d'azione e risponde alle domande sulle tue registrazioni. L'IA vocale e l'IA di ricerca non ne sono interessate."
          }
        }
      }
    },
    "Press ⌘V in %@ to attach everything, then send.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke ⌘V in %@, um alles anzuhängen, und sende dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa ⌘V en %@ para adjuntarlo todo y luego envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur ⌘V dans %@ pour tout joindre, puis envoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi ⌘V in %@ per allegare tutto, poi invia."
          }
        }
      }
    },
