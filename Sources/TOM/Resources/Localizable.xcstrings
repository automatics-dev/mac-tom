    "Could not reach %@ to verify the key: %@. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte zur Überprüfung des Schlüssels nicht erreicht werden: %@. Bitte Verbindung prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con %@ para verificar la clave: %@. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %@ pour vérifier la clé : %@. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %@ per verificare la chiave: %@. Controlla la connessione e riprova."
          }
        }
      }
    },
    "Custom prompts apply only to new recordings or when re-transcribing existing ones. They are not applied retroactively to your recording history.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Prompts gelten nur für neue Aufnahmen oder beim erneuten Transkribieren bestehender Aufnahmen. Sie werden nicht rückwirkend auf frühere Aufnahmen angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones personalizadas solo se aplican a las grabaciones nuevas o al volver a transcribir las existentes. No se aplican retroactivamente a tu historial de grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prompts personnalisés ne s'appliquent qu'aux nouveaux enregistrements ou lors de la retranscription d'enregistrements existants. Ils ne sont pas appliqués rétroactivement à votre historique d'enregistrements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prompt personalizzati si applicano solo alle nuove registrazioni o quando si ritrascrivono quelle esistenti. Non vengono applicati retroattivamente alla cronologia delle registrazioni."
          }
        }
      }
    },
