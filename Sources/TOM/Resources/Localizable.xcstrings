    "Cloud brain is set to %@ but no %@ API key is in Keychain. Open Settings → AI Models to add one, or switch to the local model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Cloud-KI ist %@ ausgewählt, aber im Schlüsselbund befindet sich kein %@-API-Schlüssel. Einstellungen → KI-Modelle öffnen, um einen hinzuzufügen, oder zum lokalen Modell wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cerebro en la nube está configurado como %@, pero no hay ninguna clave de API de %@ en el llavero. Abre Ajustes → Modelos de IA para añadir una, o cambia al modelo local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cerveau cloud est réglé sur %@, mais aucune clé d'API %@ ne se trouve dans le trousseau. Ouvrez Réglages → Modèles d'IA pour en ajouter une, ou passez au modèle local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cervello cloud è impostato su %@ ma nel portachiavi non è presente alcuna chiave API %@. Apri Impostazioni → Modelli IA per aggiungerne una, oppure passa al modello locale."
          }
        }
      }
    },
