    "%@ — Could not generate summary. The on-device model may still be downloading; try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Zusammenfassung konnte nicht erstellt werden. Das lokale Modell wird möglicherweise noch geladen; bitte gleich erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — No se pudo generar el resumen. Puede que el modelo local aún se esté descargando; inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Impossible de générer le résumé. Le modèle local est peut-être encore en cours de téléchargement ; réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Impossibile generare il riepilogo. Il modello on-device potrebbe essere ancora in download; riprova tra qualche istante."
          }
        }
      }
    },
    "%@ — Summary and transcript are ready": {
