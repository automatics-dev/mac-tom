    "%lld screenshots didn't fit the file limit; use Export ▸ Spec Folder for all of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Screenshots passten nicht ins Dateilimit; nutze Exportieren ▸ Spezifikationsordner für alle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld capturas no cabían en el límite de archivos; usa Exportar ▸ Carpeta de especificación para tenerlas todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captures dépassent la limite de fichiers ; utilise Exporter ▸ Dossier de spécification pour toutes les avoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld screenshot superano il limite di file; usa Esporta ▸ Cartella specifiche per averli tutti."
