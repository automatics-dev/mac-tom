    "Chrome and Chromium-based browsers (Arc, Edge, Brave) use GPU-accelerated rendering that bypasses macOS screen capture. This affects all screen recorders, not just TOM.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome und Chromium-basierte Browser (Arc, Edge, Brave) verwenden GPU-beschleunigtes Rendering, das die macOS-Bildschirmaufnahme umgeht. Das betrifft alle Bildschirmrekorder, nicht nur TOM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome y los navegadores basados en Chromium (Arc, Edge, Brave) usan renderizado acelerado por GPU que elude la captura de pantalla de macOS. Esto afecta a todos los grabadores de pantalla, no solo a TOM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome et les navigateurs basés sur Chromium (Arc, Edge, Brave) utilisent un rendu accéléré par le GPU qui contourne la capture d'écran de macOS. Cela affecte tous les enregistreurs d'écran, pas seulement TOM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome e i browser basati su Chromium (Arc, Edge, Brave) usano un rendering con accelerazione GPU che aggira la cattura dello schermo di macOS. Questo riguarda tutti i registratori di schermo, non solo TOM."
          }
        }
      }
    },
    "Chrome → Settings → System → Toggle OFF \"Use hardware acceleration when available\" → Relaunch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome → Einstellungen → System → „Hardwarebeschleunigung verwenden, falls verfügbar“ deaktivieren → Neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome → Configuración → Sistema → Desactiva \"Usar aceleración por hardware cuando esté disponible\" → Reinicia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome → Paramètres → Système → Désactivez « Utiliser l'accélération graphique si disponible » → Relancez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome → Impostazioni → Sistema → Disattiva \"Usa l'accelerazione hardware quando disponibile\" → Riavvia"
          }
        }
      }
    },
