    "Whisper isn't downloaded yet. Open Settings → AI Models and finish the model download first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper ist noch nicht geladen. Zuerst Einstellungen → KI-Modelle öffnen und den Modell-Download abschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper aún no está descargado. Abre Ajustes → Modelos de IA y completa primero la descarga del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper n'est pas encore téléchargé. Ouvrez Réglages → Modèles d'IA et terminez d'abord le téléchargement du modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper non è ancora scaricato. Apri Impostazioni → Modelli IA e completa prima il download del modello."
          }
        }
      }
    },
    "You may need to restart TOM after granting Screen Recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Erteilen der Bildschirmaufnahme-Berechtigung muss TOM eventuell neu gestartet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que tengas que reiniciar TOM después de conceder el permiso de grabación de pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez peut-être redémarrer TOM après avoir autorisé l'enregistrement de l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere necessario riavviare TOM dopo aver concesso l'autorizzazione Registrazione schermo"
          }
        }
      }
    },
    "You're All Set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
