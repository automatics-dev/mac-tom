    "%@ rejected this API key. Check it's still active in your account dashboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diesen API-Schlüssel abgelehnt. Bitte im Account-Dashboard prüfen, ob er noch aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rechazado esta clave de API. Comprueba que sigue activa en el panel de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé cette clé d'API. Vérifiez qu'elle est toujours active dans le tableau de bord de votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato questa chiave API. Verifica che sia ancora attiva nella dashboard del tuo account."
          }
        }
      }
    },
    "%@ rejected this API key: %@. Check the key is still active in your account dashboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diesen API-Schlüssel abgelehnt: %@. Bitte im Account-Dashboard prüfen, ob der Schlüssel noch aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rechazado esta clave de API: %@. Comprueba que la clave sigue activa en el panel de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé cette clé d'API : %@. Vérifiez que la clé est toujours active dans le tableau de bord de votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato questa chiave API: %@. Verifica che la chiave sia ancora attiva nella dashboard del tuo account."
          }
        }
      }
    },
