          }
        }
      }
    },
    "Select one or more audio or video files. Each file is processed sequentially through transcription, summary, and embeddings — files beyond the first show a Queued badge in the recording list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine oder mehrere Audio- oder Videodateien auswählen. Jede Datei durchläuft nacheinander Transkription, Zusammenfassung und Embeddings — alle Dateien nach der ersten erhalten in der Aufnahmeliste die Kennzeichnung „In Warteschlange“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona uno o varios archivos de audio o vídeo. Cada archivo se procesa secuencialmente mediante transcripción, resumen y embeddings — los archivos posteriores al primero muestran la insignia \"En cola\" en la lista de grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ou plusieurs fichiers audio ou vidéo. Chaque fichier passe successivement par la transcription, le résumé et les embeddings — au-delà du premier, les fichiers affichent un badge « En file d'attente » dans la liste des enregistrements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona uno o più file audio o video. Ogni file viene elaborato in sequenza attraverso trascrizione, riepilogo ed embedding — i file successivi al primo mostrano il badge In coda nell'elenco delle registrazioni."
          }
        }
      }
    },
